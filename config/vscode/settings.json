{
  "breadcrumbs.enabled": false,
  "chat.agents.claude.preferAgentHost": false,
  "chat.agentsControl.enabled": "hidden",
  "chat.experimental.useSkillAdherencePrompt": true,
  "chat.fontFamily": "'DankMono Nerd Font', 'JetBrainsMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
  "chat.mcp.gallery.enabled": true,
  "chat.tips.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.useClaudeHooks": true,
  "custom-ui-style.electron": {
    "frame": false
  },
  "custom-ui-style.external.imports": [
    "file://${userHome}/.vscode/custom.css",
    "file://${userHome}/.vscode/custom.js"
  ],
  "custom-ui-style.font.monospace": "'DankMono Nerd Font', 'JetBrainsMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
  "custom-ui-style.font.sansSerif": "'DankMono Nerd Font', 'JetBrainsMono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "diffEditor.wordWrap": "on",
  "editor.accessibilitySupport": "off",
  "editor.autoIndentOnPaste": true,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.guides.bracketPairs": "active",
  "editor.hover.showLongLineWarning": false,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.smoothScrolling": true,
  "editor.snippetSuggestions": "none",
  "editor.stickyScroll.enabled": false,
  "editor.tabSize": 2,
  "editor.trimAutoWhitespace": true,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 150,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "extensions.ignoreRecommendations": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/.worktrees": true,
    "**/Thumbs.db": true
  },
  "git.autofetch": true,
  "git.blame.editorDecoration.enabled": true,
  "git.blame.ignoreWhitespace": true,
  "git.blame.statusBarItem.enabled": false,
  "git.branchPrefix": "feat/",
  "git.confirmSync": false,
  "git.diagnosticsCommitHook.enabled": true,
  "git.enableCommitSigning": true,
  "git.fetchOnPull": true,
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.claudeAgent.useSdkExtension": true,
  "github.copilot.chat.codesearch.enabled": true,
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.external.osxExec": "Ghostty.app",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.suggest.quickSuggestions": {
    "arguments": "on",
    "commands": "on",
    "unknown": "off"
  },
  "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
  "window.commandCenter": false,
  "window.customTitleBarVisibility": "never",
  "window.newWindowProfile": "Default",
  "window.titleBarStyle": "native",
  "workbench.activityBar.compact": true,
  "workbench.activityBar.location": "top",
  "workbench.browser.dataStorage": "ephemeral",
  "workbench.browser.experimentalUserTools.enabled": true,
  "workbench.browser.openLocalhostLinks": true,
  "workbench.browser.searchEngine": "duckduckgo",
  "workbench.browser.showInTitleBar": true,
  "workbench.editor.useModal": "off",
  "workbench.experimental.modernUI": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.productIconTheme": "material-product-icons",
  "workbench.settings.editor": "json",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  "zenMode.centerLayout": false,
  "zenMode.fullScreen": false,
  "zenMode.hideActivityBar": true,
  "zenMode.hideLineNumbers": false
}