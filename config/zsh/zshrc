# Zinit installation is explicit; shell startup must never download code.
if [[ ! -r "$ZINIT_INSTALL_DIR/zinit.zsh" ]]; then
  print -u2 "Zinit is not installed. Run: just --justfile ~/.dotfiles/Justfile zinit-install"
  return 1
fi

source "$ZINIT_INSTALL_DIR/zinit.zsh"

# Load zinit's completion system
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# Deferred plugins — turbo mode loads them after the first prompt for faster startup.
# Declaration order is load order and it matters: fzf-tab has to come after the compinit
# below but before anything that wraps widgets (highlighting, autosuggestions).

# fzf UI for zsh's own completion menu — it replaces the menu, not the completion
# system, so every zstyle in completions.zsh still applies. Styled in plugins/fzf.zsh.
zi ice wait lucid atinit"zicdreplay"
zi light Aloxaf/fzf-tab

zi ice wait lucid
zi light zdharma-continuum/fast-syntax-highlighting

# Extra completion definitions. `blockf` stops the plugin from touching $fpath itself;
# zinit symlinks its `_*` functions into $ZINIT_COMPLETIONS_DIR, which is already on
# $fpath before the compinit below runs. Nothing is sourced, so startup cost is nil.
zi ice wait lucid blockf atpull"zinit creinstall -q ."
zi light zsh-users/zsh-completions

# Fish-like inline suggestions from history, falling back to the completion system.
# Variables must be set before the plugin loads; `atload` starts it manually because
# turbo loading happens after zsh has already built the line editor.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
# Async fetching is on by default on zsh >= 5.0.8, so it is not set here.
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20 # skip suggestions for long lines (pasted commands)
ZSH_AUTOSUGGEST_MANUAL_REBIND=1    # bind widgets once instead of on every prompt
zi ice wait lucid atload"!_zsh_autosuggest_start"
zi light zsh-users/zsh-autosuggestions

# =============================================================================================
# Shell
# =============================================================================================

[ -f "$ZSH_CONFIG_DIR/aliases.zsh" ] && source "$ZSH_CONFIG_DIR/aliases.zsh" # Aliases
[ -f "$ZSH_CONFIG_DIR/settings.zsh" ] && source "$ZSH_CONFIG_DIR/settings.zsh" # Settings
[ -f "$ZSH_CONFIG_DIR/functions.zsh" ] && source "$ZSH_CONFIG_DIR/functions.zsh" # Functions
[ -f "$ZSH_CONFIG_DIR/completions.zsh" ] && source "$ZSH_CONFIG_DIR/completions.zsh" # Completions

# =============================================================================================
# Completion initialization — must run BEFORE plugins that call compdef
# =============================================================================================
COMPDUMP="${ZSH_CACHE_DIR}/.zcompdump"
autoload -Uz compinit
# Run the full compinit — including its ~20 ms compaudit scan — at most once a
# day; otherwise trust the dump and load it directly.
#
# The age test must happen in a real glob context. `[[ -n $file(#qN.mh+24) ]]`
# looks like it works but does NOT: filename generation is not performed inside
# [[ ]], so the qualifier is ignored, the word is just the literal path, and the
# test is true whenever the variable is non-empty — which forced the slow path on
# every single shell. Array assignment does glob, so the qualifier applies.
_compdump_stale=( ${COMPDUMP}(Nmh+24) )
if (( ${#_compdump_stale} )); then
  compinit -d "$COMPDUMP"
else
  compinit -C -d "$COMPDUMP"
fi
unset _compdump_stale

[ -d "$ZSH_CONFIG_DIR/plugins" ] && {
  # ── Core (always loaded) ───────────────────────────────────────────────
  source "$ZSH_CONFIG_DIR/plugins/starship.zsh"
  source "$ZSH_CONFIG_DIR/plugins/directories.zsh"
  source "$ZSH_CONFIG_DIR/plugins/grep.zsh"
  source "$ZSH_CONFIG_DIR/plugins/brew.zsh"
  source "$ZSH_CONFIG_DIR/plugins/fzf.zsh"
  source "$ZSH_CONFIG_DIR/plugins/carapace.zsh"
  source "$ZSH_CONFIG_DIR/plugins/nvim.zsh"

  # ── Languages & runtimes ───────────────────────────────────────────────
  source "$ZSH_CONFIG_DIR/plugins/android.zsh"
  source "$ZSH_CONFIG_DIR/plugins/rust.zsh"
  source "$ZSH_CONFIG_DIR/plugins/python.zsh"
  source "$ZSH_CONFIG_DIR/plugins/node.zsh"
  source "$ZSH_CONFIG_DIR/plugins/pnpm.zsh"
  source "$ZSH_CONFIG_DIR/plugins/yarn.zsh"
  source "$ZSH_CONFIG_DIR/plugins/composer.zsh"

  # ── Git & DevOps ───────────────────────────────────────────────────────
  source "$ZSH_CONFIG_DIR/plugins/docker.zsh"
  source "$ZSH_CONFIG_DIR/plugins/kubectl.zsh"
  source "$ZSH_CONFIG_DIR/plugins/helm.zsh"
  source "$ZSH_CONFIG_DIR/plugins/k9s.zsh"
  source "$ZSH_CONFIG_DIR/plugins/terraform.zsh"
  source "$ZSH_CONFIG_DIR/plugins/gitlab.zsh"

  # ── Frameworks (command-guarded, available after changing directories) ─
  source "$ZSH_CONFIG_DIR/plugins/maven.zsh"
  source "$ZSH_CONFIG_DIR/plugins/artisan.zsh"
  source "$ZSH_CONFIG_DIR/plugins/django.zsh"
  source "$ZSH_CONFIG_DIR/plugins/bench.zsh"
  source "$ZSH_CONFIG_DIR/plugins/quarkus.zsh"
}

# Activate mise LAST so it runs after every other PATH modification (plugins
# above, VSCode/Copilot shell integration, zinit, etc.). This keeps mise's
# install paths at the front and silences `mise doctor`'s path-order warning.
(( $+commands[mise] )) && _cache_eval "mise" "mise activate zsh" "$commands[mise]"

# Compile compdump in background if stale
if [[ -s "$COMPDUMP" && (! -s "${COMPDUMP}.zwc" || "$COMPDUMP" -nt "${COMPDUMP}.zwc") ]]; then
  zcompile "$COMPDUMP"
fi
