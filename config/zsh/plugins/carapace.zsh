# =============================================================================================
# ~/.config/zsh/plugins/carapace.zsh
# =============================================================================================
# Carapace completion engine
#
# Carapace ships argument-level completion specs for the ~700 commands zsh has no
# completion for — coreutils, ssh, curl, tar, jq, ffmpeg, awk, find, and so on.
# It registers all of them through a single `compdef`, so fzf-tab renders them like
# any other completion.
#
# For docs and more info, see: https://carapace.sh
# =============================================================================================
# License: MIT Copyright (c) 2025 Wilfried Kirin AGO <https://wilfriedago.me>
# =============================================================================================

# Check if carapace is installed
if (( ! $+commands[carapace] )); then
  return
fi

# Carapace's compdef runs after compinit, so every command it claims shadows the native
# completion. Exclude the ones whose completions are owned elsewhere: generated by the
# other plugins in this directory, or shipped by zsh and Homebrew.
#
# The generated init is cached by _cache_eval and only refreshed when the carapace binary
# changes — delete "$ZSH_CACHE_DIR/carapace.zsh" after editing this list.
# `npm` is deliberately absent: `npm completion` emits an old-style compctl script, which
# fzf-tab cannot render, so carapace's spec is the better completion for it.
export CARAPACE_EXCLUDES='artisan,bench,brew,docker,doctl,gh,git,glab,helm,k9s,kubectl,mvn,pnpm,quarkus,terraform,yarn'

# Initialization — cached for faster startup
_cache_eval "carapace" "carapace _carapace zsh" "$commands[carapace]"
