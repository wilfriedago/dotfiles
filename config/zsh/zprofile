# .zprofile is sourced on login shells and before .zshrc.

# Homebrew initialization — cached for faster startup
_brew_cache="${ZSH_CACHE_DIR:-$HOME/.cache/zsh}/brew-shellenv.zsh"
[[ -d "${_brew_cache:h}" ]] || mkdir -p "${_brew_cache:h}"
if [[ -f /opt/homebrew/bin/brew ]]; then
  if [[ ! -f "$_brew_cache" ]] || [[ /opt/homebrew/bin/brew -nt "$_brew_cache" ]]; then
    /opt/homebrew/bin/brew shellenv >| "$_brew_cache"
  fi
  source "$_brew_cache"
fi
unset _brew_cache
